<?xml version="1.0" encoding="utf-8"?>
<!--
  Vesperine —— WebView 壳

  设计说明：
    这个 App 本质是一个壳，加载运行在测试服务器上的 Web 前端。
    与该品类通用做法 的架构一致（它也是「轻原生壳 + WebView 承载业务 UI」，
    见 Floze复刻开发规格书.md §3.1）。

  服务地址通过 BuildConfig.SERVER_URL 注入（见 app/build.gradle），
  也可在 App 内长按标题栏修改（存 SharedPreferences）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="top.lurvy.vesperine">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 保存生成图片到相册。
         Android 10+ 走 MediaStore，不需要权限；
         这条只为 7.0–9.0 兜底，因此用 maxSdkVersion 限制到 28，
         避免在新系统上多申请一个不必要的敏感权限。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
